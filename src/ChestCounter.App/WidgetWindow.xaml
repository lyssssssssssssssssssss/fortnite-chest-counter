<Window x:Class="ChestCounter.App.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chest Counter"
        Width="300" Height="264" MinWidth="220" MinHeight="194"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Display">
    <Border x:Name="Card" CornerRadius="12" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
            MouseLeftButtonDown="OnCardMouseDown">
        <Border.ContextMenu>
            <ContextMenu x:Name="Menu" Opened="OnMenuOpened">
                <MenuItem x:Name="MenuSession" Header="Start session" Click="OnSessionClick" />
                <MenuItem Header="Open dashboard" Click="OnDashboardClick" FontWeight="SemiBold" />
                <Separator />
                <MenuItem x:Name="MenuTopmost" Header="Keep on top" IsCheckable="True" Click="OnTopmostClick" />
                <MenuItem x:Name="MenuLock" Header="Lock position" IsCheckable="True" Click="OnLockClick" />
                <MenuItem Header="Opacity">
                    <MenuItem Header="100%" Tag="1.0" Click="OnOpacityClick" />
                    <MenuItem Header="85%" Tag="0.85" Click="OnOpacityClick" />
                    <MenuItem Header="70%" Tag="0.7" Click="OnOpacityClick" />
                    <MenuItem Header="55%" Tag="0.55" Click="OnOpacityClick" />
                </MenuItem>
                <MenuItem Header="Reset size" Click="OnResetSizeClick" />
                <Separator />
                <MenuItem Header="Settings…" Click="OnSettingsClick" />
                <MenuItem Header="Minimise to tray" Click="OnHideClick" />
                <MenuItem Header="Exit" Click="OnExitClick" />
            </ContextMenu>
        </Border.ContextMenu>

        <Viewbox Stretch="Uniform">
            <Grid Width="300" Height="264" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="66" />
                    <RowDefinition Height="13" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="38" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Grid.Row="0" Margin="16,12,12,0" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="OnLockClick" x:Name="LockButton"
                            ToolTip="Lock / unlock the widget position" VerticalAlignment="Center">
                        <TextBlock x:Name="LockGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Text="&#xE785;"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Ellipse x:Name="StatusDot" DockPanel.Dock="Right" Width="7" Height="7" Margin="0,0,10,0" Fill="{StaticResource OkBrush}"
                             VerticalAlignment="Center" ToolTip="Status" />
                    <TextBlock Text="CHESTS" FontSize="12.5" FontWeight="Bold" Foreground="#E6E6EA" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Big numbers -->
                <Grid Grid.Row="1" Margin="16,2,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <TextBlock x:Name="TotalText" Text="0" FontSize="38" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" Margin="0,-6,0,0" />
                        <TextBlock Text="total" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="1,-5,0,0" />
                    </StackPanel>
                    <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource DividerBrush}" Margin="18,4,18,8" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <TextBlock x:Name="LastBigText" Text="–" FontSize="38" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,-6,0,0" />
                        <TextBlock Text="last match" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="1,-5,0,0" />
                    </StackPanel>
                </Grid>

                <Rectangle Grid.Row="2" Height="1" Fill="{StaticResource DividerBrush}" Margin="16,6,16,6" />

                <!-- Detail rows -->
                <Grid Grid.Row="3" Margin="16,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="22" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Session" FontSize="12.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run x:Name="SessionMain" Text="not started" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <Run x:Name="SessionDetail" Text="" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>

                    <TextBlock Grid.Row="1" Text="Last" FontSize="12.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run x:Name="LastMain" Text="–" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <Run x:Name="LastDetail" Text="" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>

                    <TextBlock Grid.Row="2" Text="Games" FontSize="12.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" x:Name="GamesLine">
                        <Run x:Name="GamesMain" Text="–" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                        <Run x:Name="GamesDetail" Text="" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>

                    <TextBlock Grid.Row="3" Text="Treasures" FontSize="12.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" x:Name="TreasureLine">
                        <Run Text="★" FontSize="12.5" Foreground="{StaticResource StarBrush}" />
                        <Run x:Name="TreasureText" Text="–" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    </TextBlock>
                </Grid>

                <!-- Footer: session controls, dashboard, status -->
                <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{StaticResource DividerBrush}" Margin="0,0,0,0">
                    <DockPanel Margin="12,0,18,0" VerticalAlignment="Center">
                        <Button x:Name="SessionButton" DockPanel.Dock="Left" Style="{StaticResource GoldChipButton}" Click="OnSessionClick"
                                Content="▶ Start session" ToolTip="Start counting a playing session" />
                        <Button DockPanel.Dock="Left" Style="{StaticResource ChipButton}" Margin="6,0,0,0" Click="OnDashboardClick"
                                Content="Dashboard ↗" ToolTip="Open the full dashboard in your browser" />
                        <TextBlock x:Name="StatusText" Text="Starting…" FontSize="10" Foreground="{StaticResource DimBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
                    </DockPanel>
                </Border>
            </Grid>
        </Viewbox>
    </Border>
</Window>
