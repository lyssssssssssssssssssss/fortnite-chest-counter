<Window x:Class="ChestCounter.App.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chest Counter – permission needed" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True"
        Background="#141417" Foreground="#EDEDF0" FontFamily="{StaticResource UiFont}" FontSize="13.5"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Point">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#C9C9D1" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="LineHeight" Value="19" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Tick">
            <Setter Property="Foreground" Value="#3CCB7F" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,1,10,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ChipButton}">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Focusable" Value="True" />
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Padding="26,22,26,20" Background="#141417">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/app-64.png" Width="40" Height="40" Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Welcome to Chest Counter" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Counts the Fortnite chests you open and destroy." Foreground="#9A9AA3" />
                </StackPanel>
            </StackPanel>

            <TextBlock Margin="0,18,0,10" TextWrapping="Wrap" FontSize="14.5" FontWeight="SemiBold">
                To count your chests, Chest Counter needs your permission to read the replay files Fortnite saves on this PC.
            </TextBlock>

            <!-- Folder -->
            <Border Background="#1C1C21" BorderBrush="#2E2E35" BorderThickness="1" CornerRadius="10" Padding="14,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Change…" Click="OnChangeFolder" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <StackPanel>
                        <TextBlock Text="REPLAY FOLDER" FontSize="11" FontWeight="Bold" Foreground="#8E8E98" />
                        <TextBlock x:Name="FolderText" Margin="0,3,0,0" TextWrapping="Wrap" FontFamily="Consolas, Cascadia Mono" FontSize="12.5" />
                        <TextBlock x:Name="FolderStatus" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- What it does / doesn't -->
            <Grid Margin="2,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource Tick}" Text="✓" />
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Point}" Margin="0,0,0,8">
                    <Run FontWeight="SemiBold" Foreground="#EDEDF0">Only reads replay files</Run> in that folder. They are opened read-only and are never changed, moved or deleted.
                </TextBlock>
                <TextBlock Grid.Row="1" Style="{StaticResource Tick}" Text="✓" />
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Point}" Margin="0,0,0,8">
                    <Run FontWeight="SemiBold" Foreground="#EDEDF0">Never touches Fortnite itself</Run>: no access to the game, its memory or its files, and no inputs. Nothing that could affect your account or anti-cheat.
                </TextBlock>
                <TextBlock Grid.Row="2" Style="{StaticResource Tick}" Text="✓" />
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Point}" Margin="0,0,0,8">
                    <Run FontWeight="SemiBold" Foreground="#EDEDF0">Nothing leaves your PC</Run>: it doesn't use the internet. Your stats are saved only on this PC, and the dashboard opens only on this PC.
                </TextBlock>
                <TextBlock Grid.Row="3" Style="{StaticResource Tick}" Text="✓" />
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Point}">
                    <Run FontWeight="SemiBold" Foreground="#EDEDF0">You stay in control</Run>: you can withdraw this permission any time in Settings.
                </TextBlock>
            </Grid>

            <Border Background="#241D0E" BorderBrush="#5A4516" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,16,0,0">
                <TextBlock TextWrapping="Wrap" Foreground="#F1DCAE" FontSize="12.5">
                    In Fortnite, turn on <Run FontWeight="Bold">Settings → Game → Replays → Record Replays</Run>. Without replays there is nothing to count.
                </TextBlock>
            </Border>

            <CheckBox x:Name="StartupBox" IsChecked="True" Foreground="#E2E2E6" Margin="0,16,0,0" VerticalContentAlignment="Top">
                <TextBlock TextWrapping="Wrap" Foreground="#E2E2E6">
                    Start Chest Counter when I sign in to Windows <Run Foreground="#9A9AA3">(recommended, so no match is missed)</Run>
                </TextBlock>
            </CheckBox>

            <DockPanel Margin="0,20,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" x:Name="AllowButton" Content="Allow and start" Click="OnAllow" IsDefault="True"
                        Style="{StaticResource GoldChipButton}" Padding="18,7" FontSize="13" Focusable="True" Margin="10,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Don't allow" Click="OnDeny" IsCancel="True" />
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
