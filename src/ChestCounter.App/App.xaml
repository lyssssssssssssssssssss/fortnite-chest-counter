<Application x:Class="ChestCounter.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Palette (matches the dashboard) -->
            <Color x:Key="PanelColor">#F2141417</Color>
            <SolidColorBrush x:Key="PanelBrush" Color="#F2141417" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#2E2E35" />
            <SolidColorBrush x:Key="DividerBrush" Color="#2A2A30" />
            <SolidColorBrush x:Key="GoldBrush" Color="#F0B43C" />
            <SolidColorBrush x:Key="TextBrush" Color="#F4F4F6" />
            <SolidColorBrush x:Key="MutedBrush" Color="#9A9AA3" />
            <SolidColorBrush x:Key="DimBrush" Color="#6E6E78" />
            <SolidColorBrush x:Key="StarBrush" Color="#A98BF5" />
            <SolidColorBrush x:Key="OkBrush" Color="#3CCB7F" />
            <SolidColorBrush x:Key="WarnBrush" Color="#F0B43C" />
            <SolidColorBrush x:Key="BadBrush" Color="#E5534B" />
            <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>

            <!-- Small flat buttons used in the widget footer -->
            <Style x:Key="ChipButton" TargetType="Button">
                <Setter Property="Foreground" Value="#D8D8DE" />
                <Setter Property="Background" Value="#1F1F24" />
                <Setter Property="BorderBrush" Value="#33333B" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#2A2A31" />
                                    <Setter TargetName="b" Property="BorderBrush" Value="#4A4A55" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GoldChipButton" TargetType="Button" BasedOn="{StaticResource ChipButton}">
                <Setter Property="Foreground" Value="#1A1407" />
                <Setter Property="Background" Value="#F0B43C" />
                <Setter Property="BorderBrush" Value="#F0B43C" />
            </Style>

            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Foreground" Value="#7C7C86" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="2">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#E2E2E8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
