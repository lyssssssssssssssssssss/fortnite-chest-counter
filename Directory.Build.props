<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.1.1</Version>
    <Company>Chest Counter</Company>
    <Product>Chest Counter</Product>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Vendored third-party code (lib/) is kept close to upstream; don't drown real warnings in its noise. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('\lib\'))">
    <Nullable>annotations</Nullable>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8629;CS0168;CS0219;CS1998;CA2022;CS0162;CS0618</NoWarn>
  </PropertyGroup>
</Project>
